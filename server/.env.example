# Copy to .env on the server and fill in:  cp .env.example .env

# Domain of the API — its DNS A record must point at the server
API_DOMAIN=api.interno.uz

# Database password (any long random string):  openssl rand -base64 32
POSTGRES_PASSWORD=

# Signs login tokens; at least 32 chars:  openssl rand -base64 48
# Changing it logs everyone out.
JWT_SECRET=

# Frontend addresses allowed to call the API (comma-separated; * = wildcard
# inside the host, here: every Vercel preview of the project)
CORS_ORIGINS=https://app.internoedu.uz,https://interno-school-app.vercel.app,https://interno-school-*-aziz-tfxs-projects.vercel.app

# Only for the one-off imports (npm run import:firestore / import:amo):
# the same service-account JSON the Vercel functions use, on one line
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Daily automations at 14:00 Tashkent (reminders, debtors, LMS blocking).
# Turned on by deploy/cutover.sh on the evening of the switch from Firebase.
# AUTOMATIONS=on

# Telegram bot of the main school, if it isn't filled in on the Integrations
# page (the same values as on Vercel)
# TG_BOT_TOKEN=
# TG_CHAT_TASHKENT=
# TG_CHAT_SAMARKAND=
# TG_CHAT_FERGANA=
# TG_CHAT_BUKHARA=

# OnlinePBX and the LMS helper of the main school (also on the Integrations page / deploy/secrets.sh)
# ONPBX_DOMAIN=
# ONPBX_API_KEY=
# GOOGLE_AI_KEY=

# Optional
# JWT_TTL=7d
# LOG_LEVEL=info
# AUTH_RATE_LIMIT=10
