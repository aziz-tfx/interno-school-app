# Copy to .env on the server and fill in:  cp .env.example .env

# Domain of the API — its DNS A record must point at the server
API_DOMAIN=api.interno.uz

# Database password (any long random string):  openssl rand -base64 32
POSTGRES_PASSWORD=

# Signs login tokens; at least 32 chars:  openssl rand -base64 48
# Changing it logs everyone out.
JWT_SECRET=

# Frontend addresses allowed to call the API (comma-separated; * = wildcard
# inside the host, here: every Vercel preview of the project)
CORS_ORIGINS=https://interno-school-app.vercel.app,https://interno-school-*-aziz-tfxs-projects.vercel.app

# Only for the one-off imports (npm run import:firestore / import:amo):
# the same service-account JSON the Vercel functions use, on one line
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional
# JWT_TTL=7d
# LOG_LEVEL=info
# AUTH_RATE_LIMIT=10
